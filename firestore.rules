rules_version = '2';
// 部署指令：firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 共用判斷 ──
    function signedIn() {
      return request.auth != null;
    }
    // 管理者白名單的文件 ID 是 email 把 @ 和 . 換成 _（跟 super-admin/login.html 的 emailKey 同一套算法）。
    // 要求 email_verified：管理者後台只開放 Google 登入（一定是已驗證），
    // 這樣別人就不能用 email/密碼搶先註冊一個白名單上的信箱來冒充。
    function isSuperAdmin() {
      return signedIn()
        && 'email' in request.auth.token
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/superAdmins/$(request.auth.token.email.lower().replace('[@.]', '_')))
        && get(/databases/$(database)/documents/superAdmins/$(request.auth.token.email.lower().replace('[@.]', '_'))).data.get('enabled', true) != false;
    }
    // 呼叫者是不是 schoolId 這所學校的校管理者（role 只有 super-admin 能設定，見 /teachers 規則）
    function isSchoolAdminOf(schoolId) {
      return signedIn()
        && schoolId != ''
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('role', '') == 'school-admin'
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('schoolId', '') == schoolId;
    }
    // 這次 update 動到哪些欄位
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // 教師自己的資料：擁有者本人或 super-admin 可改刪；沒有 teacherUid 的舊資料維持原本「已登入即可」
    function ownsOrLegacy() {
      return signedIn()
        && (resource.data.get('teacherUid', '') in ['', request.auth.uid] || isSuperAdmin());
    }

    // 系統設定（維護模式、公告）—— index.html 不需登入就要讀，所以允許公開讀；只有 super-admin 能改
    match /siteSettings/{doc} {
      allow read:  if true;
      allow write: if isSuperAdmin();
    }

    // 管理者白名單 —— 登入流程需要讀取自己那一筆，所以已登入者可 get；列出全部與寫入僅限 super-admin
    // （原本任何已登入者都能寫，等於註冊一個帳號就能把自己加成管理者）
    match /superAdmins/{doc} {
      allow get:   if signedIn();
      allow list:  if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // 教師帳號 —— 管理者後台需讀取全部，任何已登入使用者可讀
    // 寫入：本人可建立/更新自己的資料，但不能碰 role、blocked（否則可以自己升成校管理者或自己解除封鎖）；
    // 校管理者不能自己換學校（否則等於可以變成任何學校的校管理者）。
    // 校管理者只能封鎖/解封同校教師；role、學校指派等其餘異動僅限 super-admin。
    match /teachers/{uid} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
                    && !request.resource.data.keys().hasAny(['role', 'blocked']);
      allow update: if (signedIn() && request.auth.uid == uid
                        && !changedKeys().hasAny(['role', 'blocked'])
                        && (!changedKeys().hasAny(['schoolId']) || resource.data.get('role', 'teacher') != 'school-admin'))
                    || (changedKeys().hasOnly(['blocked']) && isSchoolAdminOf(resource.data.get('schoolId', '')))
                    || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // 報讀庫（有聲教材）—— 只有本人可讀寫，確保各教師資料隔離
    match /teachers/{uid}/reader-library/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 學校 —— 登入頁選學校需公開讀，建立/停用僅限 super-admin
    match /schools/{schoolId} {
      allow read:  if true;
      allow write: if isSuperAdmin();
    }

    // 班級 —— 學生 PIN 登入後需查詢班級，所以允許公開讀
    // 改刪：負責教師本人、該校校管理者、super-admin。
    // 另外放行一種情況：schoolId 還是空的舊班級，校管理者可以幫它補上自己學校的 schoolId
    // （admin/school-admin.js 載入名單時會自動補，只准動 schoolId / schoolName 兩個欄位）。
    match /classes/{classId} {
      allow read:   if true;
      allow create: if signedIn();
      allow update: if signedIn() && (
                      resource.data.get('teacherUid', '') == request.auth.uid
                      || isSchoolAdminOf(resource.data.get('schoolId', ''))
                      || (resource.data.get('schoolId', '') == ''
                          && changedKeys().hasOnly(['schoolId', 'schoolName'])
                          && isSchoolAdminOf(request.resource.data.get('schoolId', '')))
                      || isSuperAdmin()
                    );
      allow delete: if signedIn() && (
                      resource.data.get('teacherUid', '') == request.auth.uid
                      || isSchoolAdminOf(resource.data.get('schoolId', ''))
                      || isSuperAdmin()
                    );
    }

    // 班級分享的報讀文件 —— 學生（無 Auth）可讀，教師可寫
    match /classes/{classId}/sharedReaderDocs/{docId} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // 班級分享的語文練習試卷 —— 學生（無 Auth）可讀，教師可寫
    match /classes/{classId}/sharedQuizSessions/{docId} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // 班級分享的課文全文（課文趣 App 用，配套生字詞取自 questions）—— 學生（無 Auth）可讀，教師可寫
    match /classes/{classId}/sharedLessonTexts/{docId} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // 課文趣：教師自己的課文全文（未分享前只有本人可讀寫，確保各教師資料隔離）
    // 注意：尚未存過課文的課次，文件不存在，此時 resource 為 null —— 讀取需放行，
    // 否則每次點開「還沒建立過課文」的課次都會被判定為 permission-denied
    match /lessonTexts/{docId} {
      allow read: if request.auth != null && (resource == null || resource.data.teacherUid == request.auth.uid);
      allow update, delete: if request.auth != null && resource.data.teacherUid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.teacherUid == request.auth.uid;
    }
    // 課文編輯的子集合（版本歷史、本課語詞）—— match 不會自動套用到子集合，一定要各自寫一條規則，
    // 否則預設全部拒絕（曾經因為漏寫這條，功能在畫面上看起來成功、其實 Firestore 寫入全部被擋下）。
    // 擁有者判斷要回頭查母文件的 teacherUid；課文還沒儲存過（母文件不存在）時先放行，跟上面母文件
    // 規則「resource == null 時放行」是同一個理由——docId 本身已經用 currentTeacher.uid 編碼過，
    // 不會跟別人的課文撞到。
    match /lessonTexts/{docId}/vocab/{word} {
      allow read, write: if request.auth != null && (
        !exists(/databases/$(database)/documents/lessonTexts/$(docId)) ||
        get(/databases/$(database)/documents/lessonTexts/$(docId)).data.teacherUid == request.auth.uid
      );
    }
    match /lessonTexts/{docId}/versions/{versionId} {
      allow read, write: if request.auth != null && (
        !exists(/databases/$(database)/documents/lessonTexts/$(docId)) ||
        get(/databases/$(database)/documents/lessonTexts/$(docId)).data.teacherUid == request.auth.uid
      );
    }

    // 學生 —— PIN 登入不走 Firebase Auth，PIN 是在瀏覽器端比對的，所以單筆讀取與學生端的寫入必須公開。
    // 在這個前提下能做的限制：
    //   - 列出（查詢）：未登入者一定要帶 limit 且不超過 100，不能一次把全部學生撈走
    //     （學生端的查詢只有「選座號」與「姓名＋PIN 登入」，見 src/auth.js，都有帶 limit）
    //   - 修改：未登入者只能動學生自己會改的欄位；姓名、座號、學校、原班等學籍欄位只有教師能改
    //   - 刪除：只有已登入的教師
    // 學生端新增會寫入的欄位時，要同步加進下面的清單，否則會被擋下。
    match /students/{studentId} {
      allow get:    if true;
      allow list:   if signedIn() || request.query.limit <= 100;
      allow create: if true;
      allow update: if signedIn()
                    || changedKeys().hasOnly(['avatar', 'nickname', 'pin', 'classIds', 'completedTasks', 'lastSeen']);
      allow delete: if signedIn();
    }
    // 學生的子集合（progress / stats / activities / strokes）—— 學生端要讀寫自己的進度；刪除只有教師
    match /students/{studentId}/{sub}/{doc} {
      allow read:           if true;
      allow create, update: if true;
      allow delete:         if signedIn();
    }

    // 課程 —— 學生（無 Auth）可讀，教師/管理者可寫
    match /curriculum/{doc=**} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // 語文練習題庫 —— 教師可讀寫，學生（無 Auth）可讀
    match /questions/{doc} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // 語文練習測驗代碼 —— 學生（無 Auth）可讀，教師可建立，只有出題教師本人能改刪
    match /quizSessions/{doc} {
      allow read:   if true;
      allow create: if signedIn();
      allow update, delete: if ownsOrLegacy();
    }

    // 語文練習作答結果 —— 學生（無 Auth）可讀，create 需有基本欄位，禁止事後修改；擁有者教師可刪除
    match /quizResults/{doc} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['sessionId', 'score', 'studentId'])
                    && request.resource.data.score is int
                    && request.resource.data.score >= 0
                    && request.resource.data.score <= 100;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.teacherUid == request.auth.uid;
    }

    // 語文測驗作答明細（docId 與 quizResults 同一筆）—— 學生（無 Auth）交卷時建立，
    // 內容是學生每題的作答，只有出題老師能讀（教師端列印作答卷給家長看）；禁止事後修改
    match /quizResultDetails/{doc} {
      // resource == null：舊作答沒有明細文件，讓 get() 回「不存在」而不是 permission-denied
      allow read:   if request.auth != null && (resource == null || resource.data.teacherUid == request.auth.uid);
      allow create: if request.resource.data.keys().hasAll(['sessionId', 'teacherUid', 'studentId', 'details'])
                    && request.resource.data.details is map;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.teacherUid == request.auth.uid;
    }

    // 四則運算測驗代碼 —— 學生（無 Auth）可讀，教師可建立，只有出題教師本人能改刪
    match /mathQuizSessions/{doc} {
      allow read:   if true;
      allow create: if signedIn();
      allow update, delete: if ownsOrLegacy();
    }

    // 四則運算作答結果 —— 學生（無 Auth）可讀（測驗清單要顯示自己考過的分數，比照語文、英文；
    // 原本只開放教師讀，學生端的查詢一直被擋下、清單上看不到自己的分數）、可 create，禁止修改/刪除
    match /mathQuizResults/{doc} {
      allow read:   if true;
      allow create: if request.resource.data.keys().hasAll(['sessionId', 'score', 'studentId'])
                    && request.resource.data.score is int
                    && request.resource.data.score >= 0
                    && request.resource.data.score <= 100;
      allow update, delete: if false;
    }

    // 英文測驗 —— 學生（無 Auth）可讀，教師可建立，只有出題教師本人能改刪
    match /englishQuizSessions/{doc} {
      allow read:   if true;
      allow create: if signedIn();
      allow update, delete: if ownsOrLegacy();
    }

    // 英文測驗作答結果 —— 學生（無 Auth）可讀（測驗清單要顯示自己考過的分數）、create 需有基本欄位，
    // 禁止事後修改；擁有者教師可刪除
    match /englishQuizResults/{doc} {
      allow read:   if true;
      allow create: if request.resource.data.keys().hasAll(['sessionId', 'score', 'studentId'])
                    && request.resource.data.score is int
                    && request.resource.data.score >= 0
                    && request.resource.data.score <= 100;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.teacherUid == request.auth.uid;
    }

    // 詞語圖庫 —— 學生（無 Auth）可讀，教師（已登入）可寫
    match /wordImages/{doc} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // 英文圖庫 —— 學生（無 Auth）可讀，教師（已登入）可寫
    match /englishImages/{doc} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // 英文單元設定（發音組合清單）—— 學生可讀，教師可寫
    match /englishUnits/{doc} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // 自訂詞語類別（教師自建，無版本依存）—— 學生可讀，教師可寫
    match /customCategories/{doc} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // 自訂詞語類別班級指派 —— 學生可讀，教師可寫
    match /customCategoryAssignments/{doc} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // 部件趣：字元拆解對照表（部件拼貼遊戲用，全校共用資料）—— 學生可讀，教師可寫
    match /charDecompositions/{doc} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // 部件趣：部件資料庫（每個部件一筆全校共用資料，取代舊的 radicalSets/radicalItems/radicalMeanings，
    // 資料已全數遷移完成，舊集合規則已移除）
    match /radicalGroups/{doc} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // 注音趣：注音符號圖庫（37 個固定符號，全校共用資料）—— 學生可讀，教師可寫
    match /zhuyinSounds/{doc} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // 注音趣：結合韻圖庫（22 個固定結合韻，全校共用資料）—— 學生可讀，教師可寫
    match /zhuyinCombinedSounds/{doc} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // 數學題組 —— 學生（無 Auth）可讀（測驗時需取題），教師可寫
    match /mathQuestions/{doc} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // 音檔庫 —— 學生（無 Auth）可讀（測驗時播音），教師可寫
    match /audioClips/{doc} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // 用戶回報 —— 任何人可 create（含學生/訪客），只有 super-admin 可讀取與管理
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }
  }
}
